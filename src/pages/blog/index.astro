---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all tags
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<Layout title="Blog" description="Writing about QA engineering, test automation, and software quality by Hamid Khodabandehloo">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <p class="font-mono text-sm mb-2" style="color: var(--accent)">
      <span style="color: var(--accent-2)">$</span> cat ./blog/*
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold mb-4" style="color: var(--text)">Blog</h1>
    <p class="text-base mb-10" style="color: var(--text-muted)">
      Thoughts on quality engineering, automation, and the art of testing.
    </p>

    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-10">
        {allTags.map(tag => (
          <span class="text-xs font-mono px-2 py-1 rounded border cursor-default" style="border-color: var(--border); color: var(--text-muted); background: var(--surface)">
            #{tag}
          </span>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <div class="text-center py-20">
        <p class="font-mono text-sm" style="color: var(--text-muted)">// no posts yet — check back soon</p>
      </div>
    ) : (
      <div class="space-y-5">
        {posts.map(post => (
          <a href={`/blog/${post.id}`} class="group block p-5 rounded-lg border transition-colors hover:border-[var(--accent)]" style="background: var(--surface); border-color: var(--border)">
            <div class="flex items-start justify-between gap-4 mb-2">
              <h2 class="font-mono font-semibold text-base group-hover:text-[var(--accent)] transition-colors" style="color: var(--text)">
                {post.data.title}
              </h2>
              <time class="text-xs font-mono shrink-0 mt-1" style="color: var(--text-muted)">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <p class="text-sm leading-relaxed mb-3" style="color: var(--text-muted)">{post.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs font-mono" style="color: var(--accent-2)">#{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
