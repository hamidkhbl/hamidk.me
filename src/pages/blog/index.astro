---
import Layout from '../../layouts/Layout.astro';
import BlogTree from '../../components/BlogTree.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description="Writing about QA engineering, test automation, and software quality by Hamid Khodabandehloo">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <p class="font-mono text-sm mb-2" style="color: var(--accent)">
      <span style="color: var(--accent-2)">$</span> cat ./blog/*
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold mb-10" style="color: var(--text)">Blog</h1>

    <div class="flex gap-8 items-start">
      <!-- Tree sidebar -->
      <aside class="hidden md:block w-56 shrink-0">
        <div class="sticky top-20 p-3 rounded-lg border" style="background: var(--surface); border-color: var(--border)">
          <BlogTree />
        </div>
      </aside>

      <!-- Post list -->
      <div class="flex-1 min-w-0">
        <!-- Mobile topics toggle -->
        <div class="md:hidden mb-4">
          <button id="mobile-topics-btn" class="w-full flex items-center justify-between px-4 py-2.5 rounded-lg border font-mono text-sm transition-colors" style="background: var(--surface); border-color: var(--border); color: var(--text-muted)">
            <span>topics</span>
            <svg id="mobile-topics-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
          <div id="mobile-topics-panel" class="hidden mt-2 p-3 rounded-lg border" style="background: var(--surface); border-color: var(--border)">
            <BlogTree />
          </div>
        </div>
        {posts.length === 0 ? (
          <div class="py-20">
            <p class="font-mono text-sm" style="color: var(--text-muted)">// no posts yet — check back soon</p>
          </div>
        ) : (
          <div class="space-y-4">
            {posts.map(post => (
              <a
                href={`/blog/${post.id}`}
                class="group block p-5 rounded-lg border transition-colors hover:border-[var(--accent)]"
                style="background: var(--surface); border-color: var(--border)"
              >
                <div class="flex items-start justify-between gap-4 mb-2">
                  <h2 class="font-mono font-semibold text-base group-hover:text-[var(--accent)] transition-colors" style="color: var(--text)">
                    {post.data.title}
                  </h2>
                  <time class="text-xs font-mono shrink-0 mt-1" style="color: var(--text-muted)">
                    {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                </div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs font-mono px-1.5 py-0.5 rounded" style="background: var(--surface-2); color: var(--accent)">
                    {post.data.category.replace(/\//g, ' / ').replace(/-/g, ' ')}
                  </span>
                </div>
                <p class="text-sm leading-relaxed mb-3" style="color: var(--text-muted)">{post.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-xs font-mono" style="color: var(--accent-2)">#{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  const btn = document.getElementById('mobile-topics-btn');
  const panel = document.getElementById('mobile-topics-panel');
  const chevron = document.getElementById('mobile-topics-chevron');
  btn?.addEventListener('click', () => {
    const open = !panel!.classList.contains('hidden');
    panel!.classList.toggle('hidden', open);
    chevron!.classList.toggle('rotate-180', !open);
  });
</script>
