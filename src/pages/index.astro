---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Home" description="QA Engineer & SDET — Hamid Khodabandehloo. Automation frameworks, testing strategy, and software quality.">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 40px 40px; opacity: 0.4;"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-64 sm:w-96 h-48 sm:h-64 rounded-full blur-3xl pointer-events-none" style="background: color-mix(in srgb, var(--accent) 15%, transparent)"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-24 sm:py-36">
      <div class="max-w-2xl">
        <p class="font-mono text-sm mb-4" style="color: var(--accent)">
          <span style="color: var(--accent-2)">$</span> whoami
        </p>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 break-words" style="color: var(--text)">
          Hamid<br />
          <span style="color: var(--accent)">Khodabandehloo</span>
        </h1>

        <p class="text-lg sm:text-xl font-mono mb-4" style="color: var(--text-muted)">
          QA Engineer &amp; SDET
        </p>

        <p class="text-base leading-relaxed mb-10 max-w-xl" style="color: var(--text-muted)">
          I build automation frameworks, design testing strategies, and help teams ship software with confidence.
          Writing about quality engineering, test architecture, and the craft of breaking things intentionally.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/projects" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md font-mono text-sm font-semibold transition-opacity hover:opacity-90" style="background: var(--accent); color: #070d1a">
            view projects
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md font-mono text-sm font-semibold border transition-colors hover:border-current" style="border-color: var(--border); color: var(--text-muted)">
            read blog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills strip -->
  <section class="border-y" style="border-color: var(--border); background: var(--surface)">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
      <div class="flex flex-wrap gap-x-5 gap-y-2 items-center">
        <span class="text-xs font-mono uppercase tracking-widest" style="color: var(--text-muted)">stack</span>
        {['Python', 'Java', 'C#', 'Selenium', 'Playwright', 'PyTest', 'RestAssured', 'Postman', 'Burp Suite', 'JMeter', 'Jenkins', 'Docker', 'SQL', 'Kafka', 'Graylog'].map(skill => (
          <span class="text-sm font-mono" style="color: var(--text-muted)">{skill}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl font-bold font-mono" style="color: var(--text)">
        <span style="color: var(--accent)">//</span> featured projects
      </h2>
      <a href="/projects" class="text-sm font-mono transition-opacity hover:opacity-80" style="color: var(--accent)">
        all projects →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        {
          title: 'Selenium Framework',
          description: 'Page Object Model based test automation framework with reporting, retry logic, and CI integration.',
          tags: ['Java', 'Selenium', 'TestNG'],
          href: '#',
        },
        {
          title: 'API Test Suite',
          description: 'Contract-driven REST API testing suite with schema validation and performance benchmarks.',
          tags: ['Python', 'Pytest', 'REST'],
          href: '#',
        },
        {
          title: 'Playwright E2E',
          description: 'End-to-end test suite covering critical user journeys with visual regression testing.',
          tags: ['TypeScript', 'Playwright', 'CI'],
          href: '#',
        },
      ].map(project => (
        <a href={project.href} class="group block p-5 rounded-lg border transition-colors hover:border-[var(--accent)]" style="background: var(--surface); border-color: var(--border)">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-mono font-semibold text-sm group-hover:text-[var(--accent)] transition-colors" style="color: var(--text)">
              {project.title}
            </h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-40 group-hover:opacity-100 shrink-0 mt-0.5 transition-opacity" style="color: var(--accent)">
              <path d="M7 7h10v10M7 17 17 7"/>
            </svg>
          </div>
          <p class="text-sm mb-4 leading-relaxed" style="color: var(--text-muted)">{project.description}</p>
          <div class="flex flex-wrap gap-1.5">
            {project.tags.map(tag => (
              <span class="text-xs font-mono px-2 py-0.5 rounded" style="background: var(--surface-2); color: var(--text-muted)">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent posts -->
  {posts.length > 0 && (
    <section class="border-t" style="border-color: var(--border)">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xl font-bold font-mono" style="color: var(--text)">
            <span style="color: var(--accent)">//</span> recent posts
          </h2>
          <a href="/blog" class="text-sm font-mono transition-opacity hover:opacity-80" style="color: var(--accent)">
            all posts →
          </a>
        </div>

        <div class="space-y-4">
          {posts.map(post => (
            <a href={`/blog/${post.id}`} class="group flex items-start justify-between gap-4 p-4 rounded-lg border transition-colors hover:border-[var(--accent)]" style="background: var(--surface); border-color: var(--border)">
              <div>
                <h3 class="font-mono font-semibold text-sm mb-1 group-hover:text-[var(--accent)] transition-colors" style="color: var(--text)">
                  {post.data.title}
                </h3>
                <p class="text-sm" style="color: var(--text-muted)">{post.data.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="text-xs font-mono" style="color: var(--accent-2)">#{tag}</span>
                  ))}
                </div>
              </div>
              <time class="text-xs font-mono shrink-0 mt-0.5" style="color: var(--text-muted)">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
